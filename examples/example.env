##--- Global args:

## always run via screen
# export SCREEN_ENABLE_RUN_VIA_SCREEN="true"

## Enable dub log output to terminal
# export LOG_ENABLE_DEBUG="true"

## Write logs in file. Dir should created!
# export LOG_SCRIPT_FILE="/root/init.log"

## Add unix timestamp to file path as suffix
# export LOG_UNIX_SECONDS_TO_PATH="true"

## Disable some asks for continue
## Warning! Use with attention!
## Also, some asks cannot will skipped.
# export NOT_ASK="true"

##--- Disable phases:

## phase upgrade_pkgs
# export DISABLE_UPGRADE_ALL="true"

## phase remove_upgrade
# export DISABLE_REMOVE_UPGRADE="true"

## phase users
# export DISABLE_USERS="true"

## phase hostname
# export DISABLE_HOSTNAME="true"

## phase sshd
# export DISABLE_PREPARE_SSHD="true"

## phase docker
# export DISABLE_DOCKER="true"

## phase install_additional_pkgs
# export DISABLE_INSTALL_ADDITIONAL_PACKAGES="true"

## phase atop
# export DISABLE_ATOP="true"

## phase gitlab
# export DISABLE_GITLAB="true"

## phase gitlab_register
# export DISABLE_GITLAB_REGISTER_RUNNER="true"

## phase werf
# export DISABLE_WERF="true"

## phase aliases
# export DISABLE_ALIASES="true"

## phase remove_passed_config
# export DISABLE_CLEANUP_PASSED_CONFIG="true"

##---

##--- Phase sshd

# Change port
# export SSHD_PORT="887"

# Change listen address
# export SSHD_LISTEN_ADDRESS="0.0.0.0"

##---

##--- Phase add users

## First user: no sudo no password no key
# export ADD_USER_0_NAME="first"
# export ADD_USER_0_SUDO="false" 
# export ADD_USER_0_PASSWORD=""
# export ADD_USER_0_NO_PASSWORD="true"
# export ADD_USER_0_SSH_KEY=""

## second user: sudo with password with key file
# export ADD_USER_1_NAME="second"
# export ADD_USER_1_SUDO="true"
## Password should have >= 12 symbols and has >=1: upper, lower letter, number and spec-symbol from list +=.|,\/?!;]:[*%$^@><#&~   
# export ADD_USER_1_PASSWORD="PassFor0neUser!"
# export ADD_USER_1_SSH_KEY="/home/ubuntu/.ssh/authorized_keys"

## third user: sudo with password with key string, no ask sudo password
# export ADD_USER_2_NAME="third"
# export ADD_USER_2_SUDO="true"
# export ADD_USER_2_SUDO_NO_PASS="true"
## Password should have >= 12 symbols and has >=1: upper, lower letter, number and spec-symbol from list +=.|,\/?!;]:[*%$^@><#&~   
# export ADD_USER_2_PASSWORD="Pass@ForS3c0ndUser."
# export ADD_USER_2_SSH_KEY="ssh-rsa AAAAB3NzaC1yc2EAAAA"

##---

##--- Phase hostname

## hostname for set
# export NEW_HOSTNAME="my-host"

##---

##--- Phase docker

## install additional packages for docker
## comma-separated packages lists
# export DOCKER_ADDITIONAL_PACKAGES="luci-app-dockerman,kmod-my"

##---

##--- Phase install additional packages

## comma-separated packages lists
# export INSTALL_ADDITIONAL_PACKAGES="git,golang"

##--- Phase gitlab_register

## path to .env files with envs below
# export GITLAB_RUNNER_CONFIG="/root/gitlab-runner-conf.env"

## or export envs directly

## url to gitlab runner
# export GITLAB_RUNNER_URL="gitlab.example.com/aaaaa"
## token for created runner
# export GITLAB_RUNNER_TOKEN="token"
## name
# export GITLAB_RUNNER_DESC="my-runner"
## comma separated tags for runner
# export GITLAB_RUNNER_TAGS="linux,docker,build"

##---
